generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  QA
  DEVELOPER
  VIEWER
}

enum ProjectRole {
  ADMIN
  QA
  DEVELOPER
  VIEWER
}

enum BugStatus {
  BACKLOG
  OPEN
  INVESTIGATING
  IN_PROGRESS
  READY_FOR_QA
  TESTING
  RESOLVED
  REOPENED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  TRIVIAL
  MINOR
  MAJOR
  CRITICAL
  BLOCKER
}

enum AttachmentKind {
  IMAGE
  VIDEO
  FILE
  LINK
}

enum TestExecutionStatus {
  PASSED
  FAILED
  BLOCKED
  NOT_TESTED
}

enum ReleaseStatus {
  READY
  AT_RISK
  BLOCKED
}

enum HistoryEventType {
  CREATED
  FIELD_CHANGED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  ATTACHMENT_ADDED
  LINKED_TEST
  REOPENED
  CLOSED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  sessionVersion      Int                  @default(0)
  oauthAccounts       OAuthAccount[]
  passwordResets      PasswordReset[]
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  authoredBugs        Bug[]                @relation("BugAuthor")
  assignedBugs        Bug[]                @relation("BugAssignee")
  comments            BugComment[]
  historyEvents       BugHistory[]
  assignedTestCases   TestCase[]
  testExecutions      TestExecution[]
  notifications       Notification[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  members       OrganizationMember[]
  projects      Project[]
  notifications Notification[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  key            String          @unique
  description    String?
  bugSequence    Int             @default(0)
  testSequence   Int             @default(0)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  bugs           Bug[]
  tags           Tag[]
  testCases      TestCase[]
  testRuns       TestRun[]
  releases       Release[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Bug {
  id                  String          @id @default(cuid())
  projectId           String
  releaseId           String?
  friendlyId          String          @unique
  title               String
  description         String
  module              String
  environment         String?
  version             String?
  priority            Priority
  severity            Severity
  status              BugStatus       @default(BACKLOG)
  authorId            String
  assigneeId          String?
  reproductionSteps   Json
  expectedResult      String?
  actualResult        String?
  technicalContext    String?
  qualityScore        Int
  qualityScoreVersion Int             @default(1)
  qualityBreakdown    Json
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release             Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  author              User            @relation("BugAuthor", fields: [authorId], references: [id])
  assignee            User?           @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments            BugComment[]
  attachments         BugAttachment[]
  history             BugHistory[]
  tags                BugTag[]
  sourceExecutions    TestExecution[] @relation("GeneratedBug")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  resolvedAt          DateTime?
  closedAt            DateTime?

  @@index([projectId, status, updatedAt])
  @@index([projectId, priority, status])
  @@index([assigneeId, status])
  @@index([authorId])
  @@index([releaseId])
}

model BugComment {
  id        String   @id @default(cuid())
  bugId     String
  authorId  String
  body      String
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bugId, createdAt])
  @@index([authorId])
}

model BugAttachment {
  id          String         @id @default(cuid())
  bugId       String
  kind        AttachmentKind
  name        String
  storageKey  String?
  externalUrl String?
  mimeType    String?
  sizeBytes   Int?
  bug         Bug            @relation(fields: [bugId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([bugId, createdAt])
}

model BugHistory {
  id        String           @id @default(cuid())
  bugId     String
  actorId   String
  type      HistoryEventType
  field     String?
  fromValue String?
  toValue   String?
  metadata  Json?
  bug       Bug              @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User             @relation(fields: [actorId], references: [id])
  createdAt DateTime         @default(now())

  @@index([bugId, createdAt])
  @@index([actorId])
}

model Tag {
  id        String   @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bugs      BugTag[]

  @@unique([projectId, name])
}

model BugTag {
  bugId String
  tagId String
  bug   Bug    @relation(fields: [bugId], references: [id], onDelete: Cascade)
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bugId, tagId])
  @@index([tagId])
}

model TestCase {
  id            String          @id @default(cuid())
  projectId     String
  friendlyId    String
  title         String
  module        String
  priority      Priority
  preconditions String?
  assigneeId    String?
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  steps         TestStep[]
  executions    TestExecution[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([projectId, friendlyId])
  @@index([projectId, module])
  @@index([assigneeId])
}

model TestStep {
  id             String   @id @default(cuid())
  testCaseId     String
  position       Int
  action         String
  expectedResult String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, position])
}

model TestRun {
  id          String          @id @default(cuid())
  projectId   String
  releaseId   String?
  name        String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release     Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  executions  TestExecution[]
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  @@index([projectId, createdAt])
  @@index([releaseId])
}

model TestExecution {
  id             String              @id @default(cuid())
  testRunId      String
  testCaseId     String
  executorId     String?
  generatedBugId String?
  status         TestExecutionStatus @default(NOT_TESTED)
  notes          String?
  testRun        TestRun             @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase       TestCase            @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  executor       User?               @relation(fields: [executorId], references: [id], onDelete: SetNull)
  generatedBug   Bug?                @relation("GeneratedBug", fields: [generatedBugId], references: [id], onDelete: SetNull)
  executedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@unique([testRunId, testCaseId])
  @@index([status])
  @@index([testCaseId])
  @@index([executorId])
  @@index([generatedBugId])
}

model Release {
  id               String        @id @default(cuid())
  projectId        String
  name             String
  version          String
  status           ReleaseStatus @default(AT_RISK)
  qualityScore     Int
  scoringVersion   Int           @default(1)
  scoringBreakdown Json
  testsTotal       Int           @default(0)
  testsPassed      Int           @default(0)
  testsFailed      Int           @default(0)
  testsBlocked     Int           @default(0)
  openCriticalBugs Int           @default(0)
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bugs             Bug[]
  testRuns         TestRun[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  releasedAt       DateTime?

  @@unique([projectId, version])
  @@index([projectId, status, createdAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  href           String?
  metadata       Json?
  readAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String
  email          String
  role           OrganizationRole @default(VIEWER)
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, email])
}

model OAuthAccount {
  id        String @id @default(cuid())
  provider  String
  subject   String
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([provider, subject])
  @@unique([userId, provider])
}

model OAuthChallenge {
  id        String @id
  provider  String
  verifier  String
  userId    String?
  expiresAt DateTime
}

model PasswordReset {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model RateWindow {
  key       String @id
  count     Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}
